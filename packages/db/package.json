{
  "name": "@evidra/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:migrate": "tsx src/migrate.ts",
    "lint": "eslint src test",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@evidra/protocol": "workspace:*",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@types/pg": "8.11.10",
    "eslint": "9.17.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
