{
  "name": "evidra-protocol",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @evidra/api dev",
    "dev:web": "pnpm --filter @evidra/web dev",
    "dev:all": "pnpm --parallel --filter @evidra/api --filter @evidra/web dev",
    "db:migrate": "pnpm --filter @evidra/db db:migrate",
    "read:certify": "node --import tsx scripts/phase1-read-certification.ts",
    "indexer:bootstrap": "node --import tsx scripts/phase1-indexer-bootstrap.ts",
    "verify:contracts": "node scripts/verify-contract-hashes.mjs",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "test:browser": "pnpm --filter @evidra/web test:browser",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.5",
    "eslint": "9.17.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.19.1"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.28",
      "sharp": "0.35.4"
    }
  }
}
